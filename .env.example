# Copy to .env locally. Leave values blank unless you run that surface.
# NEVER commit .env or real tokens. Local Jest does not need these keys.

# Optional: sibling WAIKE education repo (defaults to ../waike-research-ops)
WAIKE_REPO_ROOT=

# Optional local inference (paths only; do not commit model weights)
GUNNCHAI3K_LOCAL_GGUF_PATH=
GUNNCHAI3K_LLAMA_NGL=0

# Discord bot — HUMAN_QA_PENDING. Required only for npm run dev / npm start
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ANNOUNCEMENT_CHANNEL_ID=
SEND_ONLINE_GREETING=false

# Optional cloud APIs — unused by Gate 1 / Stage 2 routers (cloud is a failing stub)
OPENAI_API_KEY=
GITHUB_TOKEN=

# Optional legacy music integrations (not the supervisor intelligence path)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/callback
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_USER_TOKEN=

# User-ready optional downloads (explicit consent flags, default off)
GUNNCHAI_FAST_NETWORK_CONSENT=0
GUNNCHAI_AI_UR_013_LIVE_PR=0
